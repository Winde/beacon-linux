#!/usr/bin/env bash
# Flatpak entry point. Wraps the Electron binary so it runs inside the sandbox.
set -euo pipefail

export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID:-io.github.Winde.BeaconLinux}"

FLAGS=()

if [[ ${XDG_SESSION_TYPE:-} == "wayland" && -z ${DISPLAY:-} ]]; then
  if [[ -c /dev/nvidia0 ]]; then
    echo "NVIDIA on Wayland, disabling the GPU sandbox"
    FLAGS+=(--disable-gpu-sandbox)
  fi
  FLAGS+=(--ozone-platform=wayland)
  FLAGS+=(--enable-wayland-ime)
  FLAGS+=(--wayland-text-input-version=3)
fi

exec zypak-wrapper /app/bin/beacon/beacon "${FLAGS[@]}" "$@"
